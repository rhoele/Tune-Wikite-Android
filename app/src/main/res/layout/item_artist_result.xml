<?xml version="1.0" encoding="utf-8"?>
<!-- 艺人搜索结果行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_xs"
    android:paddingEnd="@dimen/spacing_xs">

    <ImageView
        android:id="@+id/iv_artist_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/colorSurfaceContainerHighest"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_account_muted" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/tv_artist_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />

    </LinearLayout>

</LinearLayout>
