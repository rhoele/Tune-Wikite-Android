<?xml version="1.0" encoding="utf-8"?>
<!--
  登录页（需求 2）：双通道登录 —— Web 端二维码扫码 + Cookie 粘贴。
  二维码：请求 unikey 绘制二维码，按 2 秒轮询扫码状态，803 确认即完成会话交接。
  Cookie：本地先做格式校验（必须含 MUSIC_U），再请求账号资料接口验证有效性。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.ClassicWiki.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/login_title" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/login_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:tabGravity="fill"
        app:tabIndicatorAnimationMode="elastic"
        app:tabMode="fixed" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 通道一：二维码扫码 -->
        <com.auramusic.wiki.classic.MaxWidthLinearLayout
            android:id="@+id/page_qr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin">

            <TextView
                android:id="@+id/tv_qr_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/login_qr_tip"
                android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginTop="@dimen/spacing_xl"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="@dimen/shape_xxl"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:id="@+id/iv_qr"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/login_qr_placeholder"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_login_qr_muted" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_qr_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:gravity="center"
                android:text="@string/login_qr_loading_key"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_qr_refresh"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:enabled="false"
                android:text="@string/login_qr_refresh" />

        </com.auramusic.wiki.classic.MaxWidthLinearLayout>

        <!-- 通道二：Cookie 粘贴 -->
        <ScrollView
            android:id="@+id/page_cookie"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <com.auramusic.wiki.classic.MaxWidthLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_horizontal_margin"
                android:paddingTop="@dimen/spacing_lg"
                android:paddingEnd="@dimen/screen_horizontal_margin"
                android:paddingBottom="@dimen/spacing_xl">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_cookie"
                    style="@style/Widget.ClassicWiki.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_cookie_label"
                    app:helperText="@string/login_cookie_helper"
                    app:helperTextEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_cookie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:maxLines="8"
                        android:minLines="5"
                        android:overScrollMode="ifContentScrolls"
                        android:scrollbars="vertical"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_paste"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/login_cookie_paste" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:text="@string/login_cookie_clear" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cookie_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/login_cookie_submit" />

            </com.auramusic.wiki.classic.MaxWidthLinearLayout>

        </ScrollView>

        <!-- 通道三：手机号（短信验证码 / 密码） -->
        <ScrollView
            android:id="@+id/page_phone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <com.auramusic.wiki.classic.MaxWidthLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_horizontal_margin"
                android:paddingTop="@dimen/spacing_lg"
                android:paddingEnd="@dimen/screen_horizontal_margin"
                android:paddingBottom="@dimen/spacing_xl">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/login_web_hint"
                    android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_web_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/login_web_action"
                    app:icon="@drawable/ic_link" />

            </com.auramusic.wiki.classic.MaxWidthLinearLayout>

        </ScrollView>

        <!-- 校验中遮罩 -->
        <LinearLayout
            android:id="@+id/login_busy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tv_busy_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/login_verifying"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
