<?xml version="1.0" encoding="utf-8"?>
<!-- 封面裁剪：1:1 方框内拖动 / 双指缩放，导出固定尺寸 JPEG。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.ClassicWiki.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/crop_title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:text="@string/crop_desc"
        android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/screen_horizontal_margin">

        <com.auramusic.wiki.classic.SquareCropView
            android:id="@+id/crop_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_crop_done"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_horizontal_margin"
        android:layout_marginEnd="@dimen/screen_horizontal_margin"
        android:layout_marginBottom="@dimen/spacing_xl"
        android:minHeight="52dp"
        android:text="@string/crop_done" />

</LinearLayout>
