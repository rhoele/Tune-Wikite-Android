<?xml version="1.0" encoding="utf-8"?>
<!-- 列表页通用四态叠加层：加载 / 空 / 错误（对应 G5） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/contrib_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/contrib_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:accessibilityLiveRegion="polite"
            android:text="@string/contrib_loading"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contrib_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/state_icon_size"
            android:layout_height="@dimen/state_icon_size"
            android:contentDescription="@string/contrib_empty_title"
            android:src="@drawable/ic_wiki_empty"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/contrib_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/contrib_empty_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/contrib_empty_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="@string/contrib_empty_desc"
            android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contrib_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/screen_horizontal_margin"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/state_icon_size"
            android:layout_height="@dimen/state_icon_size"
            android:contentDescription="@string/contrib_error_title"
            android:src="@drawable/ic_wiki_error"
            app:tint="?attr/colorError" />

        <TextView
            android:id="@+id/contrib_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:accessibilityLiveRegion="assertive"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/contrib_error_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/wiki_error_retry" />

    </LinearLayout>

</FrameLayout>
