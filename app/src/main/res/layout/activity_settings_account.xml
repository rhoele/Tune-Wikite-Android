<?xml version="1.0" encoding="utf-8"?>
<!--
  设置二级页：账号与凭据（Stage 14 · 与其他二级页统一为 MD3 分组列表）
  - 账号状态不再平铺成一段文字，而是「图标底托 + 标题 + 辅助说明 + chevron」的标准行；
  - Cookie 的输入与校验仍只在登录页保留一份，这里只提供跳转与说明。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.ClassicWiki.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings_group_account" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <com.auramusic.wiki.classic.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- ============ 分区一：当前账号 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/settings_section_account_state"
                android:textAppearance="@style/TextAppearance.ClassicWiki.FieldLabel" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/group_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingEnd="@dimen/spacing_lg">

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_account"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:md3IconTileColor="primary"
                        app:md3LeadingIcon="@drawable/ic_badge"
                        app:md3TrailingMode="chevron" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_logout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:md3IconTileColor="tertiary"
                        app:md3LeadingIcon="@drawable/ic_logout"
                        app:md3Title="@string/settings_account_logout"
                        app:md3TrailingMode="chevron" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 分区二：凭据说明 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/settings_section_account_credentials"
                android:textAppearance="@style/TextAppearance.ClassicWiki.FieldLabel" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:padding="@dimen/spacing_lg"
                    android:text="@string/settings_account_credentials_desc"
                    android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />

            </com.google.android.material.card.MaterialCardView>

        </com.auramusic.wiki.classic.MaxWidthLinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
