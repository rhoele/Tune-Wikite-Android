<?xml version="1.0" encoding="utf-8"?>
<!--
  未通过原因归档：按原因分组的审核未通过通知。
  入口不在底栏，从「设置 → 账号与提醒 → 未通过原因」进入。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.ClassicWiki.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/reject_archive_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <com.auramusic.wiki.classic.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- 汇总卡片：一个整体的 tonal 容器，避免「标题 + 按钮」散落在页面顶部 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_reject_header"
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_xl"
                    android:paddingTop="@dimen/spacing_lg"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_lg">

                    <ImageView
                        android:id="@+id/iv_reject_header_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_report"
                        app:tint="?attr/colorOnSecondaryContainer" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_reject_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/reject_archive_subtitle"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reject_sync"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:contentDescription="@string/reject_archive_sync"
                        app:icon="@drawable/ic_sync"
                        app:tooltipText="@string/reject_archive_sync" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/list_reject_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical" />

            <!-- 空态：说明 + 指向右上角同步按钮的引导（短按 / 长按两种用法） -->
            <LinearLayout
                android:id="@+id/layout_reject_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_reject_empty_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@null"
                    android:padding="14dp"
                    android:src="@drawable/ic_wiki_empty"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <TextView
                    android:id="@+id/tv_reject_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/reject_archive_empty"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ClassicWiki.Card.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/reject_archive_guide_title"
                                android:textAppearance="?attr/textAppearanceTitleSmall" />

                            <!-- 右上指向箭头：把视线引到工具栏的同步按钮 -->
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_north_east"
                                app:tint="?attr/colorPrimary" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="@string/reject_archive_guide_short"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="@string/reject_archive_guide_long"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.auramusic.wiki.classic.MaxWidthLinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
