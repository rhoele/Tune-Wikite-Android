<?xml version="1.0" encoding="utf-8"?>
<!--
  设置二级页：通知（Stage 14 · 与其他二级页统一为 MD3 分组列表）
  - 权限状态改为一行「图标底托 + 标题 + 说明 + 取值」；
  - 测试与跳转从两个通栏按钮改为可点击行，整行热区 ≥48dp。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.ClassicWiki.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings_group_notification" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <com.auramusic.wiki.classic.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- ============ 分区一：通知状态 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/settings_notification_section_state"
                android:textAppearance="@style/TextAppearance.ClassicWiki.FieldLabel" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/group_notification_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingEnd="@dimen/spacing_lg">

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_permission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:md3IconTileColor="primary"
                        app:md3LeadingIcon="@drawable/ic_notifications_active"
                        app:md3Title="@string/settings_notification_permission_title"
                        app:md3TrailingMode="value" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 分区二：测试与跳转 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/settings_notification_section_test"
                android:textAppearance="@style/TextAppearance.ClassicWiki.FieldLabel" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/group_notification_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingEnd="@dimen/spacing_lg">

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_test_notification"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:md3IconTileColor="secondary"
                        app:md3LeadingIcon="@drawable/ic_send"
                        app:md3Supporting="@string/settings_test_notification_desc"
                        app:md3Title="@string/settings_test_notification_title"
                        app:md3TrailingMode="chevron" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_system_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:md3IconTileColor="tertiary"
                        app:md3LeadingIcon="@drawable/ic_settings"
                        app:md3Supporting="@string/settings_open_system_desc"
                        app:md3Title="@string/settings_open_system_title"
                        app:md3TrailingMode="chevron" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </com.auramusic.wiki.classic.MaxWidthLinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
