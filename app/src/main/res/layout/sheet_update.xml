<?xml version="1.0" encoding="utf-8"?>
<!--
  发现新版本时的底部抽屉：与「审核消息」「选择页码」同一套骨架
  （拖拽把手 + 大标题 + 内容区 + 底部动作）。
  动作固定在说明之前，半屏打开时也能直接操作；更新说明不截断，
  拖动把手展开到全屏后可在抽屉内滚动阅读全文。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_lg">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs" />

    <TextView
        android:id="@+id/tv_update_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/settings_row_inset"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/settings_row_inset"
        android:paddingBottom="@dimen/spacing_xs"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <TextView
        android:id="@+id/tv_update_sheet_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/settings_row_inset"
        android:paddingEnd="@dimen/settings_row_inset"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_update_ignore"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_action_ignore" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_update_later"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_later" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_update_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:text="@string/update_action_download" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_update_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_row_inset"
        android:layout_marginTop="@dimen/spacing_xs"
        android:layout_marginEnd="@dimen/settings_row_inset"
        android:indeterminate="false"
        android:max="100"
        android:visibility="gone"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp" />

    <TextView
        android:id="@+id/tv_update_sheet_percent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:paddingStart="@dimen/settings_row_inset"
        android:paddingEnd="@dimen/settings_row_inset"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_update_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:clipToPadding="false"
        android:scrollbars="none">

        <TextView
            android:id="@+id/tv_update_sheet_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:paddingStart="@dimen/settings_row_inset"
            android:paddingEnd="@dimen/settings_row_inset"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
