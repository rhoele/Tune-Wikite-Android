<?xml version="1.0" encoding="utf-8"?>
<!--
  设置二级页：检查更新。
  与「未通过原因」「关于」同构：工具栏 + 卡片化的状态与版本信息；
  进度条沿用单曲上传的 Expressive 细条（圆角 2dp / 3dp 粗）与平滑推进。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.ClassicWiki.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings_group_update" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <com.auramusic.wiki.classic.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- 状态卡：图标 + 一行结论 + 可选的下载进度 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_xl"
                    android:paddingTop="@dimen/spacing_lg"
                    android:paddingEnd="@dimen/spacing_xl"
                    android:paddingBottom="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_system_update"
                            app:tint="?attr/colorOnSecondaryContainer" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_update_state"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/update_status_checking"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tv_update_detail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pb_update"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="3dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 版本信息：与设置页一致的列表行 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md">

                <LinearLayout
                    android:id="@+id/group_update_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_update_current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/settings_row_inset"
                        android:paddingEnd="@dimen/settings_row_inset"
                        app:md3Title="@string/update_label_current"
                        app:md3TrailingMode="value_plain" />

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_update_latest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/settings_row_inset"
                        android:paddingEnd="@dimen/settings_row_inset"
                        app:md3Title="@string/update_label_latest"
                        app:md3TrailingMode="value_plain" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 操作按钮放在更新说明之前：说明很长时不必先滚到底才能更新 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:minHeight="52dp"
                android:text="@string/update_action_recheck" />

            <!-- 更新说明：仅在发现新版本时出现 -->
            <LinearLayout
                android:id="@+id/group_update_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="@string/update_notes_section"
                    android:textAppearance="@style/TextAppearance.ClassicWiki.FieldLabel" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ClassicWiki.Card.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_update_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:padding="@dimen/spacing_lg"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.auramusic.wiki.classic.MaxWidthLinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
