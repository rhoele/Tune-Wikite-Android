<?xml version="1.0" encoding="utf-8"?>
<!--
  设置二级页：外观
  结构：实时预览卡 → 外观基础（主题 / 调色板 / 显示大小）→ 交互与动效。
  预览卡直接使用当前主题令牌着色，切换调色板后色卡与示例控件同步变化；
  主题模式用分段按钮（MaterialButtonToggleGroup），显示大小用滑杆，
  调色板用带色点的单选弹窗（见 AppearanceSettingsActivity#pickPalette）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.ClassicWiki.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/appearance_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/appearance_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <com.auramusic.wiki.classic.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- ============ 实时预览 ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/list_item_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/settings_row_inset">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/appearance_preview_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/tv_preview_palette"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/appearance_preview_desc"
                        android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />

                    <!-- 主题角色色卡：主色 / 次色 / 辅色 / 容器 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardBackgroundColor="?attr/colorPrimary"
                                app:cardCornerRadius="@dimen/shape_md"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/appearance_role_primary"
                                android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardBackgroundColor="?attr/colorSecondary"
                                app:cardCornerRadius="@dimen/shape_md"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/appearance_role_secondary"
                                android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardBackgroundColor="?attr/colorTertiary"
                                app:cardCornerRadius="@dimen/shape_md"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/appearance_role_tertiary"
                                android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                                app:cardCornerRadius="@dimen/shape_md"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/appearance_role_container"
                                android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- 示例控件：卡片 + 文字层级 + 状态胶囊 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/shape_field"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_lg">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/appearance_preview_sample_title"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_status_pill"
                                    android:paddingStart="@dimen/spacing_md"
                                    android:paddingTop="@dimen/spacing_xs"
                                    android:paddingEnd="@dimen/spacing_md"
                                    android:paddingBottom="@dimen/spacing_xs"
                                    android:text="@string/appearance_preview_pill"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnPrimaryContainer" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/appearance_preview_sample_body"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tv_font_preview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:text="@string/appearance_font_preview"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorPrimary" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 外观基础 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/appearance_section_base"
                android:textAppearance="@style/TextAppearance.ClassicWiki.GroupLabel" />

            <!--
              外观基础是一个整体分组：主题模式 / 调色板 / 显示大小 / 设置项样式
              跟随「设置项样式」在「一张整卡」与「四张独立卡片」之间切换。
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_appearance_group"
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/list_item_spacing">

                <LinearLayout
                    android:id="@+id/appearance_group_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/settings_row_inset"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/settings_row_inset"
                    android:paddingBottom="@dimen/spacing_md">

                    <!-- 分区一：主题模式（三项卡片式单选） -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_theme_section"
                        style="@style/Widget.ClassicWiki.Card.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/theme_section_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/settings_row_inset"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingEnd="@dimen/settings_row_inset"
                            android:paddingBottom="@dimen/spacing_md">

                            <!-- 主题模式：左中右三列分段选择（Expressive 控件） -->
                            <TextView
                                android:id="@+id/tv_theme_section"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/appearance_section_theme"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <LinearLayout
                                android:id="@+id/theme_segments"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/btn_theme_system"
                                    style="@style/Widget.ClassicWiki.ThemeSegment"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_weight="1">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <ImageView
                                            android:id="@+id/iv_theme_system"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:contentDescription="@null"
                                            android:src="@drawable/ic_contrast" />

                                        <TextView
                                            android:id="@+id/tv_theme_system"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/appearance_theme_system"
                                            android:textAppearance="?attr/textAppearanceLabelMedium" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/btn_theme_light"
                                    style="@style/Widget.ClassicWiki.ThemeSegment"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_marginStart="@dimen/spacing_xs"
                                    android:layout_weight="1">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <ImageView
                                            android:id="@+id/iv_theme_light"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:contentDescription="@null"
                                            android:src="@drawable/ic_light_mode" />

                                        <TextView
                                            android:id="@+id/tv_theme_light"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/appearance_theme_light"
                                            android:textAppearance="?attr/textAppearanceLabelMedium" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/btn_theme_dark"
                                    style="@style/Widget.ClassicWiki.ThemeSegment"
                                    android:layout_width="0dp"
                                    android:layout_height="64dp"
                                    android:layout_marginStart="@dimen/spacing_xs"
                                    android:layout_weight="1">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <ImageView
                                            android:id="@+id/iv_theme_dark"
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:contentDescription="@null"
                                            android:src="@drawable/ic_dark_mode" />

                                        <TextView
                                            android:id="@+id/tv_theme_dark"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/appearance_theme_dark"
                                            android:textAppearance="?attr/textAppearanceLabelMedium" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- 分区二：调色板 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_palette"
                        style="@style/Widget.ClassicWiki.Card.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/palette_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/settings_row_inset"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingEnd="@dimen/settings_row_inset"
                            android:paddingBottom="@dimen/spacing_md">

                    <!-- 调色板：圆形色点横向条（Expressive 的取色方式，替代弹窗列表） -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/appearance_section_palette"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <TextView
                        android:id="@+id/tv_palette_current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:clipToPadding="false"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/palette_strip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                    <!-- 色彩风格：同一底色下切换方案变体（HCG 生成的四套令牌） -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/variant_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_variant_tonal"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/appearance_variant_tonal" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_variant_vibrant"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/appearance_variant_vibrant" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_variant_expressive"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/appearance_variant_expressive" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_variant_neutral"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/appearance_variant_neutral" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/tv_palette_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/appearance_palette_dynamic_desc"
                        android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

                    <!-- 分区三：显示大小 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_display_size"
                        style="@style/Widget.ClassicWiki.Card.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/display_size_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/settings_row_inset"
                            android:paddingTop="@dimen/spacing_md"
                            android:paddingEnd="@dimen/settings_row_inset"
                            android:paddingBottom="@dimen/spacing_md">

                    <!-- 显示大小：滑杆 + 实时百分比 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/appearance_display_size"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <TextView
                        android:id="@+id/tv_font_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorPrimary" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_font"
                        style="@style/Widget.ClassicWiki.Slider.Expressive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:stepSize="0.05"
                        android:valueFrom="0.85"
                        android:valueTo="1.30"
                        app:tickVisible="false" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/appearance_display_size_desc"
                        android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

                    <!-- 分区四：设置项样式 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_appearance_row_style"
                        style="@style/Widget.ClassicWiki.Card.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/list_appearance_row_style_host"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/settings_row_inset"
                            android:paddingTop="@dimen/spacing_sm"
                            android:paddingEnd="@dimen/settings_row_inset"
                            android:paddingBottom="@dimen/spacing_sm">

                            <LinearLayout
                                android:id="@+id/list_appearance_base"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 交互与动效 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/appearance_section_experience"
                android:textAppearance="@style/TextAppearance.ClassicWiki.GroupLabel" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/settings_row_inset"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/settings_row_inset"
                    android:paddingBottom="@dimen/spacing_md">

                    <LinearLayout
                        android:id="@+id/list_experience"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tv_blur_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/appearance_blur_desc"
                        android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </com.auramusic.wiki.classic.MaxWidthLinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
