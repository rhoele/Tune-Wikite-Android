<?xml version="1.0" encoding="utf-8"?>
<!--
  设置二级页：下载与存储。

  结构与其它设置页一致：分组标签 + 独立圆角卡片 + MD3 列表行；
  顶部用一张概览卡展示封面 / 音频的占用与文件数。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.ClassicWiki.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/download_settings_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <com.auramusic.wiki.classic.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- ============ 占用概览 ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingTop="@dimen/spacing_lg"
                    android:paddingEnd="@dimen/spacing_lg"
                    android:paddingBottom="@dimen/spacing_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_storage"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="@string/download_usage_title"
                            android:textAppearance="?attr/textAppearanceTitleSmall" />

                    </LinearLayout>

                    <!-- 总量：Expressive 的大号读数 -->
                    <TextView
                        android:id="@+id/tv_download_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textAppearance="?attr/textAppearanceDisplaySmall"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <!-- 分类统计：两张有色统计块，数字使用标题字号 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardBackgroundColor="?attr/colorSecondaryContainer"
                            app:cardCornerRadius="@dimen/shape_lg"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_md">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_image"
                                    app:tint="?attr/colorOnSecondaryContainer" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_sm"
                                    android:text="@string/download_stat_covers"
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textColor="?attr/colorOnSecondaryContainer" />

                                <TextView
                                    android:id="@+id/tv_stat_cover_size"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:textAppearance="?attr/textAppearanceTitleLarge"
                                    android:textColor="?attr/colorOnSecondaryContainer"
                                    android:textStyle="bold"
                                    app:autoSizeMaxTextSize="22sp"
                                    app:autoSizeMinTextSize="13sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />

                                <TextView
                                    android:id="@+id/tv_stat_cover_count"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnSecondaryContainer" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            app:cardBackgroundColor="?attr/colorTertiaryContainer"
                            app:cardCornerRadius="@dimen/shape_lg"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/spacing_md">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_music_note"
                                    app:tint="?attr/colorOnTertiaryContainer" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_sm"
                                    android:text="@string/download_stat_audio"
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textColor="?attr/colorOnTertiaryContainer" />

                                <TextView
                                    android:id="@+id/tv_stat_audio_size"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:textAppearance="?attr/textAppearanceTitleLarge"
                                    android:textColor="?attr/colorOnTertiaryContainer"
                                    android:textStyle="bold"
                                    app:autoSizeMaxTextSize="22sp"
                                    app:autoSizeMinTextSize="13sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />

                                <TextView
                                    android:id="@+id/tv_stat_audio_count"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceLabelSmall"
                                    android:textColor="?attr/colorOnTertiaryContainer" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 保存位置 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/download_section_location"
                android:textAppearance="@style/TextAppearance.ClassicWiki.GroupLabel" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/group_download_dirs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_cover_dir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/settings_row_inset"
                        android:paddingEnd="@dimen/settings_row_inset"
                        app:md3IconTileColor="primary"
                        app:md3LeadingIcon="@drawable/ic_photo_library"
                        app:md3Title="@string/download_cover_dir"
                        app:md3TrailingMode="chevron" />

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_audio_dir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/settings_row_inset"
                        android:paddingEnd="@dimen/settings_row_inset"
                        app:md3IconTileColor="secondary"
                        app:md3LeadingIcon="@drawable/ic_audio_file"
                        app:md3Title="@string/download_audio_dir"
                        app:md3TrailingMode="chevron" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 清理 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/download_section_clean"
                android:textAppearance="@style/TextAppearance.ClassicWiki.GroupLabel" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/group_download_clean"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_delete_covers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/settings_row_inset"
                        android:paddingEnd="@dimen/settings_row_inset"
                        app:md3IconTileColor="tertiary"
                        app:md3LeadingIcon="@drawable/ic_hide_image"
                        app:md3Title="@string/download_delete_covers"
                        app:md3TrailingMode="chevron" />

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_delete_audio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/settings_row_inset"
                        android:paddingEnd="@dimen/settings_row_inset"
                        app:md3IconTileColor="tertiary"
                        app:md3LeadingIcon="@drawable/ic_delete_sweep"
                        app:md3Title="@string/download_delete_audio"
                        app:md3TrailingMode="chevron" />

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_auto_threshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/settings_row_inset"
                        android:paddingEnd="@dimen/settings_row_inset"
                        app:md3IconTileColor="tertiary"
                        app:md3LeadingIcon="@drawable/ic_data_usage"
                        app:md3Supporting="@string/download_auto_threshold_desc"
                        app:md3Title="@string/download_auto_threshold"
                        app:md3TrailingMode="switch_link" />

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_auto_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/settings_row_inset"
                        android:paddingEnd="@dimen/settings_row_inset"
                        app:md3IconTileColor="tertiary"
                        app:md3LeadingIcon="@drawable/ic_schedule"
                        app:md3Supporting="@string/download_auto_days_desc"
                        app:md3Title="@string/download_auto_days"
                        app:md3TrailingMode="switch_link" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 音频管理 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="@string/download_section_audio"
                android:textAppearance="@style/TextAppearance.ClassicWiki.GroupLabel" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ClassicWiki.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/group_download_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.auramusic.wiki.classic.Md3ListItemView
                        android:id="@+id/row_audio_manager"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/settings_row_inset"
                        android:paddingEnd="@dimen/settings_row_inset"
                        app:md3IconTileColor="primary"
                        app:md3LeadingIcon="@drawable/ic_library_music"
                        app:md3Supporting="@string/download_audio_manager_desc"
                        app:md3Title="@string/download_audio_manager"
                        app:md3TrailingMode="chevron" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_download_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_marginTop="@dimen/spacing_lg"
                android:lineSpacingExtra="3dp"
                android:text="@string/download_note"
                android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting" />

        </com.auramusic.wiki.classic.MaxWidthLinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
