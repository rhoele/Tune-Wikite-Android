# 服务端口
PORT=8787

# 管理接口鉴权（/api/fcm/send、GET /api/fcm/ack 需要 Authorization: Bearer <值>）
# 生成方式示例：openssl rand -hex 32
FCM_ADMIN_TOKEN=replace-with-a-long-random-string

# Firebase 服务账号凭据（二选一）
# 1) 指向 JSON 文件
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# 2) 直接内联 JSON（适合容器环境变量注入）
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# 令牌存储文件（生产环境建议替换为数据库 / Redis）
TOKEN_STORE=./data/tokens.json

# 出网代理（可选）。国内网络必须填写，否则访问 oauth2.googleapis.com / fcm.googleapis.com 会超时。
# 注意：FCM 默认走 HTTP/2，HTTP/2 不经过 https.globalAgent，代码会在设置本变量时
# 自动切换到 HTTP/1.1 传输，否则代理对发送请求不生效。
# HTTPS_PROXY=http://127.0.0.1:7890
