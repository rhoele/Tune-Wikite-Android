<?xml version="1.0" encoding="utf-8"?>
<!--
  艺人选择（Stage 16 · 从 AlertDialog 改为 M3 BottomSheet）
  空关键词时优先展示「已移除的艺人」，便于一键填回；输入后改为服务端搜索。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xl"
    android:paddingEnd="@dimen/spacing_xl"
    android:paddingBottom="@dimen/spacing_lg">

    <!-- 拖拽把手：可下拉关闭，符合 M3 BottomSheet 的手势预期 -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/au_artist_search_title"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_artist_search"
        style="@style/Widget.ClassicWiki.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:hint="@string/au_artist_search_hint"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_wiki_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_artist_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_artist_suggest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/au_artist_suggest"
        android:textAppearance="@style/TextAppearance.ClassicWiki.FieldLabel"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_artist_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackThickness="3dp" />

    <TextView
        android:id="@+id/tv_artist_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:gravity="center"
        android:text="@string/au_artist_search_empty"
        android:textAppearance="@style/TextAppearance.ClassicWiki.Supporting"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_artist_results"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never" />

</LinearLayout>
